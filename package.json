{
  "name": "@auditrails/node",
  "version": "1.0.0",
  "description": "Official Node.js SDK for auditrails.io — tamper-proof audit logging as a service",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "audit",
    "audit-log",
    "audit-trail",
    "compliance",
    "soc2",
    "hipaa",
    "gdpr",
    "logging",
    "security"
  ],
  "author": "AuditRails <support@auditrails.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/auditrails/auditrails-node.git"
  },
  "homepage": "https://auditrails.io",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.1",
    "@types/node": "^26.0.0"
  }
}
